# BAGMAN — example Layer 2 (runtime environment) configuration: production
#
# This is a TEMPLATE. The real production environment configuration is
# supplied externally by the deployment platform and is never committed.
# Every line here is either a non-secret value, or a path to a secret file
# mounted at runtime — never a secret value itself.

BAGMAN_ENV=production
LOG_LEVEL=info

# Non-secret connection details only — the database itself authenticates
# via a mounted secret file, never a value in this file.
BAGMAN_DB_HOST=bagman-db
BAGMAN_DB_PORT=5432
BAGMAN_DB_NAME=bagman
BAGMAN_DB_PASSWORD_FILE=/run/secrets/bagman_db_password

TZ=Europe/London

# Feature flags — safe, non-secret toggles
BAGMAN_FEATURE_EXAMPLE_FLAG=false

# evidence/automatic-classification-activation WO — the activation
# boundary for scripts/process_evidence_classification_jobs.py's own
# reconciliation pass (services/evidence/classification_job.py
# .reconcile_missing_classification_jobs). An ISO-8601 UTC string
# (e.g. 2026-10-15T00:00:00Z) marking the moment automatic evidence
# classification is genuinely activated in THIS environment; evidence
# received before it is historical and must never be reconciled. This
# is deliberately NOT set to a real value here — it is set for real
# only at the later, separately-authorised production-activation WO.
# Left unset (or commented out), the worker fails closed: reconciliation
# is skipped for every run (ordinary job claim/processing is unaffected)
# and the run's own summary JSON reports why.
# BAGMAN_EVIDENCE_CLASSIFICATION_ACTIVATION_BOUNDARY=<SET_AT_PRODUCTION_ACTIVATION_WO>

# Mailbox credentials are never set as values here — only as references to
# mounted secret files.
BAGMAN_NOUST_IMAP_PASSWORD_FILE=/run/secrets/noust_imap_password
BAGMAN_MAIL_INFOSECURS_CREDENTIALS_FILE=/run/secrets/infosecurs_mail_credentials
BAGMAN_MAIL_GMAIL_PRIMARY_CREDENTIALS_FILE=/run/secrets/gmail_primary_credentials
BAGMAN_MAIL_GMAIL_SECONDARY_CREDENTIALS_FILE=/run/secrets/gmail_secondary_credentials
