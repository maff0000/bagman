<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Governed launchd scheduler definition — PID.md §114 (Automatic Evidence
  Classification Scheduling, Architect ruling 2026-10-07), implemented per
  work-orders/WO-BAGMAN-114-AUTOMATIC-CLASSIFICATION-SCHEDULER.md §6.A.

  This file is a GOVERNED artifact, applied to the canonical BAGMAN
  production Mac mini (PID §0, 192.168.11.4) by an explicit, individually
  recorded operator command — never auto-generated, never hand-edited only
  on the appliance. See deployment/launchd/README.md for the exact
  installation/load/unload commands and the full staged-activation
  doctrine (PID §114.12) this artifact is installed, then enabled, under.

  Narrow scheduler responsibility only (PID §114.2/§114.5) — periodically
  invoke the existing, unmodified worker
  (scripts/process_evidence_classification_jobs.py) and observe its
  exit/result. This plist deliberately carries NO
  BAGMAN_EVIDENCE_CLASSIFICATION_ACTIVATION_BOUNDARY (T_ACT) value,
  reference, or override of any kind — T_ACT is sourced exclusively from
  the BAGMAN application/container environment, per PID §114.5/§112.B,
  never from this scheduler.

  Disabled-by-default: this file deliberately defines NO RunAtLoad key.
  launchd's own default for an omitted RunAtLoad is false, so installing
  (`launchctl load`) this file does not itself trigger an immediate
  classification run — the first invocation occurs only after one full
  StartInterval (300s) has elapsed following a load. "Disabled" during
  Stage D of the governing Work Order means this file is NOT loaded into
  launchd at all (see README.md).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bagman.evidence-classification-scheduler</string>

    <!--
      launchd jobs do not inherit a login shell's PATH, so the
      production docker binary's full, confirmed path is used directly
      (confirmed in work-orders/WO-BAGMAN-112F-GOVERNANCE-RECOVERY-CLOSURE.md
      §"Methodology": all read-only production inspection for this host used
      `/opt/homebrew/bin/docker` over SSH, 2026-10-07 — the real, evidenced
      docker CLI path on the canonical Mac mini appliance). A single `/bin/sh
      -c` wrapper is used only so the invocation is one self-contained,
      fully-absolute-pathed command inside this plist — it introduces no
      additional script file, no daemon, and no logic beyond the one `docker
      exec` call itself.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec /opt/homebrew/bin/docker exec bagman-api python3 scripts/process_evidence_classification_jobs.py --process --limit 20 --discovery-limit 50 --runtime-dir /opt/bagman/runtime/evidence-classification-jobs --worker-id launchd-scheduler</string>
    </array>

    <!-- PID §114.2: initial cadence, 300 seconds (5 minutes). -->
    <key>StartInterval</key>
    <integer>300</integer>

    <!-- stdout/stderr — PID §114.11's minimum-sufficient observability. -->
    <key>StandardOutPath</key>
    <string>/opt/bagman/runtime/launchd/evidence-classification-scheduler.out.log</string>

    <key>StandardErrorPath</key>
    <string>/opt/bagman/runtime/launchd/evidence-classification-scheduler.err.log</string>
</dict>
</plist>
